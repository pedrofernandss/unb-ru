- content_for :title, "Recarregar Saldo · RU UnB"
.pagina-cabecalho
  %div
    %p.sobretitulo Portal do Estudante
    %h1 Recarregar Saldo
    %p Adicione créditos para usar no RU.
- if @recarga.errors.any?
  .alerta.alerta--erro{role: "alert"}= @recarga.errors.full_messages.to_sentence
= form_with url: nova_recarga_path, class: "recarga-grade", data: { turbo: false } do
  = hidden_field_tag :chave, @chave
  .card.painel
    %fieldset.pacotes-de-refeicoes
      %legend Escolha o Pacote de Refeições
      .opcoes-grade
        - [2, 5, 10, 20].each do |quantidade|
          %label.opcao-cartao
            = radio_button_tag :quantidade, quantidade, @recarga.quantidade == quantidade
            %strong #{quantidade} Refeições
            %span= number_to_currency(quantidade * TarifaRefeicao.valor)
    .campo
      = label_tag :outra_quantidade, "Outra quantidade"
      = number_field_tag :outra_quantidade, params[:outra_quantidade], min: 1, max: 50, step: 1, class: "campo__controle"
      %small De 1 a 50 refeições. Se preenchida, substitui o pacote.
    %fieldset.metodos-de-pagamento
      %legend Selecione o Método
      .opcoes-grade
        %label.opcao-cartao
          = radio_button_tag :metodo, "PIX", @recarga.metodo == "PIX"
          %strong PIX Instantâneo
        %label.opcao-cartao
          = radio_button_tag :metodo, "Cartão", @recarga.metodo == "Cartão"
          %strong Cartão de Crédito
  %aside.card.painel.resumo-recarga
    %h2 Resumo da Recarga
    %p Tarifa unitária
    %strong= number_to_currency(TarifaRefeicao.valor)
    %p Confira a quantidade, o método e o total na próxima etapa antes de concluir o pagamento.
    = submit_tag "Confirmar", class: "botao botao--primario botao--largo"
