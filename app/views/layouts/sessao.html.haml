!!!
%html{lang: "pt-BR"}
  %head
    %title= content_for(:title) || "Sistema de Acesso UnB"
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    %meta{name: "application-name", content: "Sistema de Acesso UnB"}
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head

    %link{rel: "icon", href: "/icon.png", type: "image/png"}
    %link{rel: "apple-touch-icon", href: "/icon.png"}

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body.sessao
    .barra-gov
      .barra-gov__conteudo


    %main.sessao__principal
      - if flash[:notice]
        .alerta.alerta--sucesso{role: "status"}
          = icon :circle_check
          %div= flash[:notice]
      = yield

