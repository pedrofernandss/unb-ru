!!!
%html{lang: "pt-BR"}
  %head
    %title= content_for(:title) || "Administração Geral · RU UnB"
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    %meta{name: "application-name", content: "RU UnB Digital"}
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head

    %link{rel: "icon", href: "/icon.png", type: "image/png"}
    %link{rel: "apple-touch-icon", href: "/icon.png"}

    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body.portal
    %header.cabecalho-portal
      .cabecalho-portal__conteudo
        = link_to admin_restaurantes_path, class: "marca" do
          = image_tag "logo-unb.png", alt: "Universidade de Brasília", class: "marca__logo"
          %span.marca__texto
            %strong RU UnB Digital
            %small Administração Geral

        %nav.navegacao{"aria-label": "Administração Geral"}
          = link_to "Restaurantes e Catracas", admin_restaurantes_path, class: ("ativo" if current_page?(admin_restaurantes_path))
          = link_to "Turnos e Time-frames", admin_turnos_path, class: ("ativo" if request.path.start_with?(admin_turnos_path))
          = link_to "Relatório Global", admin_relatorio_path, class: ("ativo" if request.path.start_with?(admin_relatorio_path))

        .cabecalho-portal__usuario
          .usuario-resumo
            %strong= current_user.nome
            %small Administrador
          = button_to logout_path, method: :delete, class: "botao botao--texto", title: "Sair" do
            = icon :log_out
            Sair

    %main.portal__conteudo
      - if flash[:notice]
        .alerta.alerta--sucesso{role: "status"}
          = icon :circle_check
          %div= flash[:notice]
      - if flash[:alert]
        .alerta.alerta--erro{role: "alert"}
          = icon :circle_alert
          %div= flash[:alert]
      = yield
