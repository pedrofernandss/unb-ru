- content_for :title, "Associar Nova Catraca · RU UnB"

%section.card.painel
  %p.sobretitulo Administração Geral · Restaurantes e Catracas
  %h2.painel__titulo Associar Nova Catraca

  - if @catraca.errors.any?
    .alerta.alerta--erro{role: "alert"}
      = icon :circle_alert
      %ul.alerta__lista
        - @catraca.errors.full_messages.each do |mensagem|
          %li= mensagem

  = form_with model: [ :admin, @catraca ], class: "formulario" do |f|
    .campo{class: ("campo--erro" if @catraca.errors[:restaurante].any?)}
      .campo__cabecalho
        = f.label :restaurante_id, "Restaurante"
      .campo__entrada
        = icon :utensils
        = f.collection_select :restaurante_id, Restaurante.order(:nome), :id, :nome, prompt: "Selecione"
    .campo-linha
      .campo{class: ("campo--erro" if @catraca.errors[:numero].any?)}
        .campo__cabecalho
          = f.label :numero, "Número da Catraca"
        .campo__entrada
          = icon :qr_code
          = f.text_field :numero, inputmode: "numeric", placeholder: "Ex.: 4"
      .campo{class: ("campo--erro" if @catraca.errors[:piso].any?)}
        .campo__cabecalho
          = f.label :piso, "Piso"
        .campo__entrada
          = icon :map_pin
          = f.text_field :piso, inputmode: "numeric", placeholder: "Ex.: 2"

    = f.button class: "botao botao--primario" do
      = icon :save
      Salvar
    = link_to "Cancelar", admin_restaurantes_path, class: "botao botao--texto"
